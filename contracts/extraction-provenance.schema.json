{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstralDeep/AstralDeep/contracts/extraction-provenance.schema.json",
  "title": "Astral Component Extraction Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "digestAlgorithm",
    "source",
    "destination",
    "selectionRoots",
    "entries",
    "manifestSha256"
  ],
  "properties": {
    "format": {
      "const": "astral.extraction-provenance/v1"
    },
    "digestAlgorithm": {
      "const": "sha256"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"$ref": "#/$defs/canonicalRepository"},
        "commit": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"}
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "legacyBaseline"],
      "properties": {
        "repository": {"$ref": "#/$defs/canonicalRepository"},
        "branch": {"$ref": "#/$defs/branch"},
        "legacyBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceRef", "commit", "observedAt"],
          "properties": {
            "sourceRef": {
              "type": "string",
              "pattern": "^refs/heads/(?!-)(?!.*(?:\\.\\.|//|@\\{|\\\\))(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9._/-]*[A-Za-z0-9_-]$",
              "maxLength": 255
            },
            "commit": {"$ref": "#/$defs/sha1"},
            "observedAt": {"$ref": "#/$defs/timestamp"}
          }
        }
      }
    },
    "selectionRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "destinationPath",
          "mode",
          "blob",
          "bytes"
        ],
        "properties": {
          "sourcePath": {"$ref": "#/$defs/relativePath"},
          "destinationPath": {"$ref": "#/$defs/relativePath"},
          "mode": {
            "enum": ["100644", "100755", "120000"]
          },
          "blob": {"$ref": "#/$defs/sha1"},
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "manifestSha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "branch": {
      "type": "string",
      "pattern": "^(?!-)(?!refs/)(?!.*(?:\\.\\.|//|@\\{|\\\\))(?!.*(?:^|/)\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9._/-]*[A-Za-z0-9_-]$",
      "maxLength": 255
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "canonicalRepository": {
      "enum": [
        "https://github.com/AstralDeep/AstralDeep.git",
        "https://github.com/AstralDeep/AstralProjection.git",
        "https://github.com/AstralDeep/AstralPlane.git",
        "https://github.com/AstralDeep/AstralPrimitives.git",
        "https://github.com/AstralDeep/LETS.git"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
