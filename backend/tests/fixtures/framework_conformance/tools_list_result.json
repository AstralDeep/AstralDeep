{
  "tools": [
    {
      "name": "astral_submit_operation",
      "description": "Submit one chat-kind Work operation for the credential's owner.",
      "inputSchema": {
        "type": "object",
        "required": [
          "idempotency_key",
          "name",
          "instructions"
        ],
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Client-chosen key; a repeat call with the SAME key and content returns the original operation unchanged."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "conversation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline_in_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.submit"
      }
    },
    {
      "name": "astral_get_operation",
      "description": "Read one Work operation's current status.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "The operation id returned by astral_submit_operation."
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.read"
      }
    },
    {
      "name": "astral_list_operations",
      "description": "List the credential owner's recent Work operations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "after_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.read"
      }
    },
    {
      "name": "astral_get_operation_events",
      "description": "Poll one Work operation for a revision change.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "The operation id returned by astral_submit_operation."
          },
          "after_revision": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.read"
      }
    },
    {
      "name": "astral_cancel_operation",
      "description": "Cancel one Work operation.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id",
          "submission_id",
          "expected_revision"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "The operation id returned by astral_submit_operation."
          },
          "submission_id": {
            "type": "string",
            "description": "A fresh UUID4 per attempt."
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.control"
      }
    },
    {
      "name": "astral_pause_operation",
      "description": "Pause one Work operation.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id",
          "submission_id",
          "expected_revision"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "The operation id returned by astral_submit_operation."
          },
          "submission_id": {
            "type": "string",
            "description": "A fresh UUID4 per attempt."
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.control"
      }
    },
    {
      "name": "astral_get_artifact",
      "description": "Read one Work operation's retained result.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "The operation id returned by astral_submit_operation."
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "artifacts.read"
      }
    },
    {
      "name": "astral_emergency_status",
      "description": "Read the credential owner's emergency stop status: running, stopped, partially acknowledged, or unreachable responders.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.read"
      }
    },
    {
      "name": "astral_emergency_stop",
      "description": "Engage the owner's emergency stop: refuse new tool admission, agent dispatch, scheduled turns, and remote execution until an explicit resume.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 280
          }
        },
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.control"
      }
    },
    {
      "name": "astral_emergency_resume",
      "description": "Explicitly resume after an emergency stop; requires the current stop revision and the engaging owner's credential.",
      "inputSchema": {
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      },
      "_meta": {
        "astral/agentId": "__work__",
        "astral/requiredScope": "operations.control"
      }
    }
  ],
  "cacheScope": "private",
  "resultType": "complete",
  "ttlMs": 60000
}
