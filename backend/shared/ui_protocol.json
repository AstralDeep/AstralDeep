{
  "version": 1,
  "description": "Committed UI-protocol manifest (feature 044). Single source for the server->client WS frame vocabulary, the ui_event action vocabulary, and the component vocabulary. Backend, Windows, and Android test suites all assert against this file; adding a frame type, action, or component type REQUIRES editing it in the same PR (guards fail otherwise). See specs/044-native-client-parity/contracts/ui-protocol.md.",
  "frame_contracts": {
    "admission_refusal": {
      "type": "error",
      "exact_fields": [
        "type",
        "submission_id",
        "accepted",
        "code",
        "message",
        "retryable",
        "retry_after_ms"
      ],
      "submission_id": "canonical_lowercase_uuid4",
      "accepted": false,
      "additional_fields": false,
      "codes": [
        "capacity_exceeded",
        "registration_required",
        "registration_timeout",
        "idempotency_conflict",
        "connection_closing",
        "service_draining",
        "invalid_input",
        "registration_queue_full",
        "operation_failed"
      ]
    },
    "voice_065": {
      "schema_version": "1",
      "required_server_pushes": {
        "composer_state": ["type", "schema_version", "revision", "connection_generation", "voice"],
        "voice_control_binding": ["type", "schema_version", "device_id", "connection_generation", "binding_id", "binding", "expires_at"],
        "voice_session_state": ["type", "schema_version", "connection_generation", "session_id", "generation", "media_grant_revision", "state", "reason", "visible_chat_id", "chat_context_revision", "applied_chat_context_revision", "chat_context_synced", "speech_muted", "microphone_enabled", "foreground_active", "occurred_at"],
        "voice_turn_state": ["type", "schema_version", "connection_generation", "session_id", "generation", "media_grant_revision", "turn_id", "client_turn_id", "submission_id", "request_generation", "chat_id", "chat_context_revision", "sequence", "state", "foreground", "detected_language", "spoken_output_policy", "output_reason", "sensitive_result_pending", "occurred_at"],
        "voice_transcript": ["type", "schema_version", "session_id", "generation", "media_grant_revision", "turn_id", "client_turn_id", "submission_id", "request_generation", "chat_id", "chat_context_revision", "source_participant_identity", "sequence", "final", "detected_language", "text"],
        "user_message_acked.voice": ["type", "schema_version", "connection_generation", "voice_turn_id", "submission_id", "request_generation", "chat_id", "message_id"],
        "voice_submission_rejected": ["type", "schema_version", "connection_generation", "session_id", "generation", "media_grant_revision", "turn_id", "client_turn_id", "submission_id", "request_generation", "chat_id", "reason", "retry_policy", "occurred_at"],
        "voice_announcement_media.livekit": ["type", "schema_version", "session_id", "generation", "media_grant_revision", "worker_identity", "announcement_id", "announcement_sequence", "turn_id", "kind", "quantum_role", "quantum_index", "duration_samples", "sample_rate_hz", "transport", "track_sid", "track_name"],
        "voice_announcement_media.watch": ["type", "schema_version", "session_id", "generation", "media_grant_revision", "worker_identity", "announcement_id", "announcement_sequence", "turn_id", "kind", "quantum_role", "quantum_index", "duration_samples", "sample_rate_hz", "transport", "first_media_sequence", "last_media_sequence"]
      },
      "conditional_final_transcript_fields": ["text_digest_sha256", "transcript_proof", "proof_expires_at"],
      "conditional_result_fields": ["result_reserved_samples_after"],
      "optional_server_push_fields": {
        "voice_turn_state": {
          "speech_outcome": ["source_finished", "failed", "suppressed"]
        }
      },
      "client_frames": {
        "voice_playout_event": ["type", "schema_version", "device_id", "connection_generation", "session_id", "generation", "media_grant_revision", "announcement_id", "announcement_sequence", "turn_id", "kind", "quantum_role", "quantum_index", "phase", "client_sequence", "observed_at"]
      },
      "correlated_chat_creation": {
        "client_new_chat": {
          "type": "ui_event",
          "action": "new_chat",
          "exact_fields": ["type", "action", "schema_version", "connection_generation", "submission_id", "request_generation", "payload"],
          "payload_fields": ["schema_version", "connection_generation", "submission_id", "request_generation"],
          "correlated_fields": ["schema_version", "connection_generation", "submission_id", "request_generation"]
        },
        "server_chat_created": {
          "type": "chat_created",
          "exact_fields": ["type", "schema_version", "connection_generation", "submission_id", "request_generation", "payload"],
          "payload_fields": ["schema_version", "chat_id", "from_message", "connection_generation", "submission_id", "request_generation"],
          "correlated_fields": ["schema_version", "connection_generation", "submission_id", "request_generation"],
          "from_message": false
        }
      },
      "voice_origin_fields": ["schema_version", "session_id", "generation", "media_grant_revision", "turn_id", "client_turn_id", "chat_context_revision", "source_participant_identity", "detected_language", "text_digest_sha256", "transcript_proof", "proof_expires_at"],
      "composer_actions": {
        "voice_microphone_set": "updateVoiceSession",
        "voice_sensitive_recap_request": "consentToSensitiveRecap",
        "voice_session_end": "endVoiceSession",
        "voice_session_start": "createVoiceSession",
        "voice_session_takeover": "takeOverVoiceSession",
        "voice_speech_mute_set": "updateVoiceSession",
        "voice_speech_stop": "stopVoiceSpeech",
        "voice_visible_chat_update": "updateVoiceSession"
      },
      "required_dispositions": ["accepted", "rejected", "partial", "final", "listening", "speaking", "interrupted", "failed", "ended", "takeover_required", "permission_denied", "typed_fallback"]
    }
  },
  "push_types": [
