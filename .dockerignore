.git
.gitignore
.dockerignore
Dockerfile*

# Initialized component source is part of the composed build context. Keep this
# exception ahead of every recursive exclusion so sensitive component-local
# state below is still removed by the later, last-match-wins rules.
!components/**

**/.git
.venv
**/.venv
backend/.venv
**/backend/data
**/backend/tmp
**/backend/knowledge
**/backend/agents/**/data
**/backend/agents/**/tmp
**/backend/verification/.runs
data
build
coverage
dist
node_modules
**/node_modules
**/.gradle
**/.cxx
*.pyc
__pycache__
**/__pycache__
.pytest_cache
**/.pytest_cache
.vscode
.idea
*.log*
.env.local
.env
*.env
backend/.env
backend/*.env
**/.env
**/.env.*
**/*.env
**/*.env.*
!**/.env.example
!**/*.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/local.properties
**/keystore.properties
**/key.properties
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.log.*
components/LETS/paper/submission
components/LETS/paper/paper.pdf
components/LETS/results/generated
!.env.example
