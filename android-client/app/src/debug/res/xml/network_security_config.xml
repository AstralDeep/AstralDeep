<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds may reach local development services over cleartext. LiveKit's
  public media URL can be the Mac's current LAN address instead of 10.0.2.2,
  so an exact-host allowlist makes a valid local grant fail whenever that
  address changes. This resource is referenced only by src/debug/AndroidManifest.xml.
  Release has no networkSecurityConfig and therefore retains Android's default
  HTTPS/WSS-only policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
