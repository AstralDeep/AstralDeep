  "cases": [
    {
      "name": "valid_tool_manifest",
      "kind": "validate_manifest",
      "input": {
        "raw": "[capability]\nid = \"astral.web-fetch\"\nversion = \"2.1.0\"\nkind = \"tool\"\ndescription = \"Fetch pages through the egress proxy.\"\n\n[permissions]\nscopes = [\"tools:execute\"]\noutput_files = [\"html\", \"txt\"]\nnetwork = \"egress-proxy\"\nphi = \"none\"\n\n[limits]\ntool_timeout_seconds = 60\n\n[[tools]]\nname = \"web-fetch\"\nscript = \"tools/fetch.py\"\nscope = \"tools:execute\""
      },
      "expect": {
        "accepted": true,
        "id": "astral.web-fetch",
        "version": "2.1.0",
        "kind": "tool"
      }
    },
    {
      "name": "valid_kernel_manifest",
      "kind": "validate_manifest",
      "input": {
        "raw": "[capability]\nid = \"astral.cad-kernel\"\nversion = \"1.0.0\"\nkind = \"kernel\"\ndescription = \"build123d kernel and cad tool for building 3D models.\"\n\n[permissions]\nscopes = [\"tools:execute\"]\noutput_files = [\"step\", \"stl\", \"3mf\", \"glb\"]\nnetwork = \"none\"\nphi = \"none\"\n\n[limits]\ntool_timeout_seconds = 120\n\n[[tools]]\nname = \"cad\"\nscript = \"tools/cad_run.py\"\nscope = \"tools:execute\"\n\n[runtime]\npython = \"3.12\"\nwheels = [\"build123d==0.13.0\"]"
      },
      "expect": {
        "accepted": true,
        "id": "astral.cad-kernel",
        "version": "1.0.0",
        "kind": "kernel"
      }
    },
    {
