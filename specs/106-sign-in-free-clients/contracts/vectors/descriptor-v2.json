          "node_id": "sha256:8d212a14e09d4a6e7ac7e0d385dc0c9f363ac57a18f6410967bb39c7e5f88f9",
          "node_key": {
            "kty": "OKP",
            "crv": "Ed25519",
            "x": "2L9zFHpuUhxdOhBZQXTvU3aO5GQltWlbYQ1JeipFL9s"
          },
          "owner_hash": null,
          "capabilities": [
            "chat",
            "tool-dispatch",
            "mesh-pairing",
            "delegation-eddsa",
            "emergency-stop"
          ],
          "transport_addresses": []
        }
      },
      "expect": {
        "accepted": true,
        "capabilities": [
          "chat",
          "tool-dispatch",
          "mesh-pairing",
          "delegation-eddsa",
          "emergency-stop"
        ]
      }
