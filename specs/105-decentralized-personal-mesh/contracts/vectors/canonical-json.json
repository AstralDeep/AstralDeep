    },
    {
      "expect": {
        "ok": {
          "canonical": "{\"a\":{\"x\":9223372036854775807,\"y\":-9223372036854775808},\"z\":[3,2,{\"a\":true,\"b\":null}]}",
          "sha256": "e81db1924149b69b220a4b4d17f5a76c6d8af98357973a75137592a090595de2"
        }
      },
      "input": {
        "json": "{\"z\":[3,2,{\"b\":null,\"a\":true}],\"a\":{\"y\":-9223372036854775808,\"x\":9223372036854775807}}"
      },
      "kind": "canonical",
      "name": "nested-and-int64-bounds"
    },
    {
      "expect": {
        "ok": {
          "canonical": "{\"a\":1,\"é\":\"composed\",\"\":\"private\",\"😀\":\"astral\"}",
