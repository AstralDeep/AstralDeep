        }
      },
      "input": {
        "json": "{\"\\ud83d\\ude00\": \"astral\", \"\\ue000\": \"private\", \"\\u00e9\": \"composed\", \"a\": 1}"
      },
      "kind": "canonical",
      "name": "unicode-scalar-order"
    },
    {
      "expect": {
        "ok": {
