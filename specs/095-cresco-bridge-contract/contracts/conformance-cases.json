            "retrieved": "2026-07-06"
          },
          {
            "name": "GaiaKeep SDK",
            "identifier": "git:9f30ebaeebdfdf1f44a2980d62ab0908d809e7a9",
            "status": "pinned",
            "retrieved": "2026-10-13"
          },
          {
            "name": "AstralPlane dependency",
