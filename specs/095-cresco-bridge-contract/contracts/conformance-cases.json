{
  "contract": "specs/095-cresco-bridge-contract/contracts/bridge-contract.md",
  "bounded_on": "2026-10-13",
  "status": "bounded topology implemented behind default-off flag; effect transports unavailable; real fabric acceptance pending",
  "cases": [
    {
      "id": "C-01",
      "kind": "flag_default_off",
      "title": "FF_CRESCO default off, fail-closed",
      "expect": {
        "flag": "cresco",
        "env_var": "FF_CRESCO",
        "expected_default": false
      }
    },
    {
      "id": "C-02",
      "kind": "bridge_runtime_gated",
      "title": "Present runtime refuses calls with FF_CRESCO off",
      "expect": {
        "module": "agents.cresco",
        "tool": "cresco_list_regions",
        "fault_detail": "feature_flag_off"
      }
    },
    {
      "id": "C-03",
      "kind": "bridge_runtime_gated",
      "title": "Bridge in-process registration follows the fail-closed feature flag",
      "expect": {
        "registry": "BUILT_IN_AGENT_DIRS",
        "member": "cresco",
        "discovery_fn": "register_built_ins"
      }
    },
    {
      "id": "C-04",
      "kind": "bridge_runtime_gated",
      "title": "Public bridge identity is never automatically marked safe",
      "expect": {
        "registry": "FIRST_PARTY_PUBLIC_AGENT_IDS",
        "member": "cresco-1"
      }
    },
    {
      "id": "C-05",
      "kind": "gaiakeep_dual_flag",
      "title": "GaiaKeep enablement requires FF_GAIAKEEP and FF_CRESCO",
      "expect": {
        "entrypoint": "backend/start.py::_gaiakeep_enabled",
        "flags": [
          "gaiakeep",
          "cresco"
        ],
        "operator": "and",
        "probe": {
          "gaiakeep": true,
          "cresco": true,
          "expected": true
        }
      }
    },
    {
      "id": "C-06",
      "kind": "gaiakeep_dual_flag",
      "title": "Dual-flag truth table and fail-closed flag-read failure",
      "expect": {
        "entrypoint": "backend/start.py::_gaiakeep_enabled",
        "truth_table": [
          {
            "gaiakeep": false,
            "cresco": false,
            "expected": false
          },
          {
            "gaiakeep": true,
            "cresco": false,
            "expected": false
          },
          {
            "gaiakeep": false,
            "cresco": true,
            "expected": false
          },
          {
            "gaiakeep": true,
            "cresco": true,
            "expected": true
          }
        ],
        "flag_read_failure_result": false
      }
    },
    {
      "id": "C-07",
      "kind": "envelope_roundtrip",
      "title": "Pinned wsapi envelope shape and deterministic bulk-param encoding",
      "note": "Source-verified request routing and plain string-parameter reply format; no REQUEST/EVENT or submitwork protocol exists in the reviewed sources.",
      "expect": {
        "encoding_rule": "base64(gzip(json_bytes)), with canonical JSON and gzip.GzipFile(compresslevel=9, mtime=0), including its platform-independent OS byte 255",
        "canonical_request": {
          "message_info": {
            "message_type": "global_controller_msgevent",
            "message_event_type": "EXEC",
            "is_rpc": "true"
          },
          "message_payload": {
            "action": "listregions",
            "client_rpc_id": "case-7"
          }
        },
        "bulk_params_sample": {
          "region": "global",
          "limit": 128
        },
        "bulk_params_encoding": "H4sIAAAAAAAC/6tWysnMzSxRsjI0stBRKkpNz8zPU7JSSs/JT0rMUaoFAA/AW+ofAAAA",
        "canonical_reply": {
          "action": "listregions",
          "client_rpc_id": "case-7",
          "regionslist": "H4sIAAAAAAAC/6tWKkpNz8zPK1ayio6tBQCec+y3DgAAAA=="
        }
      }
    },
    {
      "id": "C-08",
      "kind": "transport_boundaries",
      "title": "Verified TLS and control-endpoint admission remain fail closed",
      "note": "Executes the runtime TLS configuration and endpoint/egress denial; socket-level pin-before-credential regressions run in the owning bridge module suite.",
      "expect": {
        "contract": "specs/095-cresco-bridge-contract/contracts/bridge-contract.md",
        "required_phrases": [
          "validate_egress_url",
          "CERT_NONE",
          "pinned SHA-256 certificate fingerprint",
          "/api/apisocket",
          "cresco_service_key",
          "compresslevel=9, mtime=0"
        ]
      }
    },
    {
      "id": "C-09",
      "kind": "target_grammar",
      "title": "Member-target grammar bounds admitted targets",
      "expect": {
        "grammar": "^[a-z0-9][a-z0-9-]{0,62}(_[a-z0-9][a-z0-9-]{0,62}){1,2}$",
        "max_length": 192,
        "valid": [
          "global_controller",
          "edge1_agent7",
          "edge1_agent7_telemetry"
        ],
        "invalid": [
          "",
          "controller",
          "GLOBAL_controller",
          "edge__agent",
          "edge1_agent7_telemetry_extra",
          "edge1_agent7_*",
          "edge1 agent7",
          "edge1_agent7;rm"
        ]
      }
    },
    {
      "id": "C-10",
      "kind": "fault_states",
      "title": "Closed fault-state set with fixed dispositions and no credential material",
      "expect": {
        "states": {
          "unavailable": {
            "trigger": "CRESCO_WSAPI_URL or CRESCO_SERVICE_KEY unset",
            "result": "Cresco fabric not configured",
            "retryable": false
          },
          "unreachable": {
            "trigger": "dial failure, RPC timeout, socket error",
            "result": "Cresco fabric unreachable",
            "retryable": true
          },
          "auth": {
            "trigger": "fabric rejects the service key",
            "result": "Cresco authentication failed",
            "retryable": false
          },
          "protocol": {
            "trigger": "frame drift / undecodable / unmapped failure",
            "result": "Unexpected fabric response",
            "retryable": false
          },
          "tls": {
            "trigger": "certificate verification or pin failure",
            "result": "Cresco TLS verification failed",
            "retryable": false
          }
        }
      }
    },
    {
      "id": "C-11",
      "kind": "secret_hygiene",
      "title": "No committed Cresco credential material",
      "expect": {
        "variable": "CRESCO_SERVICE_KEY",
        "wire_header": "cresco_service_key",
        "scan_paths": [
          "backend",
          "config",
          "deploy",
          "scripts",
          "specs",
          "tooling"
        ],
        "literal_pattern": "cresco_service_key[\"']?\\s*[:=]\\s*[\"'][A-Za-z0-9+/=_-]{12,}[\"']"
      }
    },
    {
      "id": "C-12",
      "kind": "manifest_hygiene",
      "title": "No Cresco/JVM/broker artifact in image manifests",
      "expect": {
        "manifests": [
          "backend/requirements.txt",
          "backend/requirements-gaiakeep.txt",
          "Dockerfile",
          "Dockerfile.voice",
          "docker-compose.yml",
          "docker-compose.staging.yml",
          "docker-compose.voice-integration.yml"
        ],
        "forbidden_terms": [
          "cresco",
          "pycrescolib",
          "activemq",
          "osgi"
        ]
      }
    },
    {
      "id": "C-13",
      "kind": "source_pins",
      "title": "Authoritative external sources carry identifier, status, and retrieval date",
      "expect": {
        "required_status_values": [
          "pinned-unreverified",
          "evaluated",
          "pinned",
          "open-external",
          "source-verified"
        ],
        "sources": [
