{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstralDeep/AstralDeep/specs/074-multirepo-lets-integration/contracts/composition-manifest.schema.json",
  "title": "Astral System Composition Manifest",
  "description": "Pins the four independent component revisions and their compatibility contracts. The containing AstralDeep commit is joined externally with the canonical manifest digest to avoid a self-reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "astraldeep_contract_version",
    "components",
    "compatibility"
  ],
  "properties": {
    "format": {
      "const": "astral.composition/v1"
    },
    "astraldeep_contract_version": {
      "$ref": "#/$defs/version"
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "astral-projection",
        "astral-plane",
        "astral-primitives",
        "lets"
      ],
      "properties": {
        "astral-projection": {
          "$ref": "#/$defs/projectionComponent"
        },
        "astral-plane": {
          "$ref": "#/$defs/planeComponent"
        },
        "astral-primitives": {
          "$ref": "#/$defs/primitivesComponent"
        },
        "lets": {
          "$ref": "#/$defs/letsComponent"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui_protocol", "data_plane", "primitives", "lets"],
      "properties": {
        "ui_protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "sha256"],
          "properties": {
            "version": {"$ref": "#/$defs/version"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "data_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "schema_revision",
            "read_compatible_from",
            "migration_sha256",
            "blob_layout_version"
          ],
          "properties": {
            "contract_version": {"$ref": "#/$defs/version"},
            "schema_revision": {"$ref": "#/$defs/revision"},
            "read_compatible_from": {"$ref": "#/$defs/revision"},
            "migration_sha256": {"$ref": "#/$defs/sha256"},
            "blob_layout_version": {"$ref": "#/$defs/version"}
          }
        },
        "primitives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_version", "contract_sha256"],
          "properties": {
            "package_version": {"$ref": "#/$defs/version"},
            "contract_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "lets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "api_version",
            "openapi_sha256",
            "receipt_wire_type",
            "scope_profile_version"
          ],
          "properties": {
            "release": {"const": "v1.0.10"},
            "api_version": {"const": "v1"},
            "openapi_sha256": {"$ref": "#/$defs/sha256"},
            "receipt_wire_type": {"const": "lets.receipt/v1"},
            "scope_profile_version": {"const": "astral.tools/v1"}
          }
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "baseComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "commit", "contract_version"],
      "properties": {
        "repository": {"type": "string"},
        "path": {"type": "string"},
        "commit": {"$ref": "#/$defs/sha1"},
        "ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "contract_version": {"$ref": "#/$defs/version"},
        "artifact_sha256": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "projectionComponent": {
      "allOf": [
        {"$ref": "#/$defs/baseComponent"},
        {
          "type": "object",
          "properties": {
            "repository": {
              "const": "https://github.com/AstralDeep/AstralProjection.git"
            },
            "path": {"const": "components/AstralProjection"}
          }
        }
      ]
    },
    "planeComponent": {
      "allOf": [
        {"$ref": "#/$defs/baseComponent"},
        {
          "type": "object",
          "properties": {
            "repository": {
              "const": "https://github.com/AstralDeep/AstralPlane.git"
            },
            "path": {"const": "components/AstralPlane"}
          }
        }
      ]
    },
    "primitivesComponent": {
      "allOf": [
        {"$ref": "#/$defs/baseComponent"},
        {
          "type": "object",
          "properties": {
            "repository": {
              "const": "https://github.com/AstralDeep/AstralPrimitives.git"
            },
            "path": {"const": "components/AstralPrimitives"}
          }
        }
      ]
    },
    "letsComponent": {
      "allOf": [
        {"$ref": "#/$defs/baseComponent"},
        {
          "type": "object",
          "properties": {
            "repository": {
              "const": "https://github.com/AstralDeep/LETS.git"
            },
            "path": {"const": "components/LETS"},
            "ref": {"const": "v1.0.10"}
          }
        }
      ]
    }
  }
}
