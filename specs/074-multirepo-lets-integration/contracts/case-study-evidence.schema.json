{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AstralDeep/AstralDeep/specs/074-multirepo-lets-integration/contracts/case-study-evidence.schema.json",
  "title": "Astral LETS Case-Study Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "evidence_class",
    "lets_release",
    "repositories",
    "composition_sha256",
    "policy_digest",
    "machine_digest",
    "config_epoch",
    "scope_profile",
    "mode",
    "environment",
    "commands",
    "artifacts",
    "measurements",
    "sanitization",
    "reproduced_at"
  ],
  "properties": {
    "format": {"const": "lets.case-study-evidence/v1"},
    "evidence_class": {
      "enum": ["release-baseline", "astral-integration"]
    },
    "lets_release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "astraldeep",
        "astral-projection",
        "astral-plane",
        "astral-primitives",
        "lets"
      ],
      "properties": {
        "astraldeep": {"$ref": "#/$defs/sha1"},
        "astral-projection": {"$ref": "#/$defs/sha1"},
        "astral-plane": {"$ref": "#/$defs/sha1"},
        "astral-primitives": {"$ref": "#/$defs/sha1"},
        "lets": {"$ref": "#/$defs/sha1"}
      }
    },
    "composition_sha256": {"$ref": "#/$defs/sha256"},
    "policy_digest": {"$ref": "#/$defs/letsDigest"},
    "machine_digest": {"$ref": "#/$defs/letsDigest"},
    "config_epoch": {"type": "integer", "minimum": 1},
    "scope_profile": {"const": "astral.tools/v1"},
    "mode": {"enum": ["off", "shadow", "enforce"]},
    "environment": {
      "type": "object",
      "description": "Non-secret hardware, OS, language, database, topology, and workload facts.",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {"$ref": "#/$defs/publicMetadataKey"},
      "additionalProperties": {"$ref": "#/$defs/environmentValue"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "exit_code",
          "started_at",
          "finished_at",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100},
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"$ref": "#/$defs/publicArg"}
          },
          "exit_code": {"type": "integer"},
          "started_at": {"$ref": "#/$defs/timestamp"},
          "finished_at": {"$ref": "#/$defs/timestamp"},
          "stdout_sha256": {"$ref": "#/$defs/sha256"},
          "stderr_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "relative_path", "sha256", "bytes"],
        "properties": {
          "kind": {"type": "string", "minLength": 1, "maxLength": 100},
          "relative_path": {"$ref": "#/$defs/relativePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "sample_count", "summary", "source_artifact"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "unit": {"type": "string", "minLength": 1, "maxLength": 50},
          "sample_count": {"type": "integer", "minimum": 1},
          "summary": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 100,
            "propertyNames": {"$ref": "#/$defs/publicMetadataKey"},
            "additionalProperties": {"type": ["number", "null"]}
          },
          "source_artifact": {"$ref": "#/$defs/relativePath"},
          "exclusions": {
            "type": "array",
            "maxItems": 100,
            "items": {"$ref": "#/$defs/publicText"}
          }
        }
      }
    },
    "sanitization": {
      "type": "object",
      "description": "Attests that the tracked capture implementation reran the public-evidence secret and PHI scanner over environment, argv, summaries, exclusions, and notes.",
      "additionalProperties": false,
      "required": ["profile", "scanner_sha256", "findings"],
      "properties": {
        "profile": {"const": "astral.case-study-public/v1"},
        "scanner_sha256": {"$ref": "#/$defs/sha256"},
        "findings": {"const": 0}
      }
    },
    "reproduced_at": {"$ref": "#/$defs/timestamp"},
    "notes": {"$ref": "#/$defs/publicText"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidence_class": {"const": "release-baseline"}},
        "required": ["evidence_class"]
      },
      "then": {
        "properties": {
          "lets_release": {"const": "v1.0.10"},
          "mode": {"const": "off"}
        }
      }
    }
  ],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "letsDigest": {
      "type": "string",
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "publicText": {
      "allOf": [
        {"$ref": "#/$defs/boundedText"},
        {
          "not": {
            "pattern": "(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]:|[Bb][Ee][Aa][Rr][Ee][Rr][ ]|(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy])[:=])"
          }
        }
      ]
    },
    "publicArg": {"$ref": "#/$defs/publicText"},
    "publicMetadataKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "not": {
        "pattern": "(?:[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy]|[Pp][Hh][Ii])"
      }
    },
    "environmentValue": {
      "anyOf": [
        {"type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "anyOf": [
              {"type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {"$ref": "#/$defs/publicMetadataKey"},
          "additionalProperties": {
            "anyOf": [
              {"type": "string", "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))(?!.*(?:[ .])(?:/|$))[^\\u0000-\\u001f\\u007f/]+(?:/[^\\u0000-\\u001f\\u007f/]+)*$"
    }
  }
}
